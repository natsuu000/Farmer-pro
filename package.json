    "db:seed": "node server/db.js seed",
    "demo:reset": "node server/db.js reset",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "bcryptjs": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "cookie-parser": "latest",
    "express": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {}
}
