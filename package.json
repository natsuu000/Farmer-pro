{
  "name": "krishisetu-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "build:deploy": "npm run build && npm run db:migrate && npm run db:seed",
    "preview": "vite preview",
